    "    \"    G.add_nodes_from(range(num_nodes))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(num_nodes):\\n\",\n",
    "    \"        for j in range(i + 1, num_nodes):\\n\",\n",
    "    \"            if random.random() < edge_prob:\\n\",\n",
    "    \"                G.add_edge(i, j)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return G\"\n",
